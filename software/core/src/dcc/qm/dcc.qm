   <file name="qm_motor.h">
    <text>#ifndef __MOTOR_H__
#define __MOTOR_H__

#include &quot;qp_signals.h&quot;

/**/

#define SPEED_STEPS ((uint8_t) 28u)

enum motor_direction {
    DIRECTION_BACKWARD = 0u,
    DIRECTION_FORWARD = 1u
};

enum acceleration_dir {
    SPEED_INCREASE = 0u,
    SPEED_DECREASE
};

$declare${motor}

#endif  /* __MOTOR_H__ */
</text>
