  <operation name="motor_ctor" type="uint32_t" visibility="0x00" properties="0x00">
   <documentation>/* Constructor for Motor controller AO */</documentation>
   <code>uint32_t res = NO_ERROR;

motor * const me = &amp;motor_inst;

QMActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;motor_initial));

me-&gt;actual_step = 0u;
me-&gt;target_step = 0u;
me-&gt;next_step = 0u;
me-&gt;direction = DIRECTION_FORWARD;
me-&gt;accel_dir = MOTOR_ACCELERATION;

QTimeEvt_ctorX(&amp;me-&gt;accel_timer, ao_motor, SPEED_TIMER_SIG, ACCEL_TICK_RATE);

QEQueue_init(&amp;me-&gt;zeroCrossingQueue, zcQueue, Q_DIM(zcQueue));

QS_OBJ_DICTIONARY(ao_motor);

QS_SIG_DICTIONARY(MOTOR_CONFIG_SIG, me);
QS_SIG_DICTIONARY(MOTOR_CTRL_START_SIG, me);
QS_SIG_DICTIONARY(MOTOR_CTRL_RECONFIGURE_SIG, me);
QS_SIG_DICTIONARY(CHANGE_SPEED_SIG, me);
QS_SIG_DICTIONARY(SET_SPEED_SIG, me);
QS_SIG_DICTIONARY(EMERGENCY_BRAKE_SIG, me);
QS_SIG_DICTIONARY(MOTOR_STOPPED_SIG, me);
QS_SIG_DICTIONARY(SPEED_REACHED_SIG, me);
QS_SIG_DICTIONARY(SPEED_TIMER_SIG, me);

return res;</code>
  </operation>
  <directory name=".">
   <file name="qm_motor.c">
    <text>#include &quot;qm_motor.h&quot;
#include &quot;motor.h&quot;

Q_DEFINE_THIS_MODULE(&quot;QM_Motor&quot;)

#define ACCEL_TIMER_PERIOD ((uint32_t) 10u)    /* 10 ms */
#define ACCEL_TICK_RATE    ((uint8_t) 0u)      /* 1 ms tick rate */
#define MOTOR_ACCELERATION ((int16_t) 1)       /* To be defined */

/* PRIVATE VARIABLES DEFINITIONS */

static motor motor_inst;

static QEvt const * zcQueue[1u];

/* PUBLIC VARIABLES DEFINITIONS */

QActive * const ao_motor = &amp;motor_inst.super.super;

/* PRIVATE FUNCTIONS DECLARATIONS */

uint32_t motor_speed_set(int16_t speed);

/* PRIVATE FUNCTIONS DEFINITIONS */

$define${motor}

/* PUBLIC FUNCTIONS DEFINITIONS */</text>
